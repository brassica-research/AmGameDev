; Engine configuration file.
; Godot 4.4+ project — see docs/07-technical-design.md

config_version=5

[application]

config/name="Let Tyrants Shake (working title)"
config/description="A brigade-scale action game of the American Revolution. History is the spine; your army is the story."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")

[autoload]

GameState="*res://src/core/game_state.gd"
CampaignDB="*res://src/core/campaign_db.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[rendering]

; Compatibility (OpenGL 3.3) is the default for the grey-box milestone:
; it runs on decade-old GPUs and machines with stale Vulkan drivers
; (e.g. GeForce 900M-era laptops reporting Vulkan 1.0.x), and M1 uses
; nothing Forward+ provides. Opt back in with:
;   godot --path game --rendering-method forward_plus
; Forward+ returns as the default at M2 look-dev (docs/09, docs/10).
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
